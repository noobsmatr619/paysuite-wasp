action deleteInvoice {
  fn: import { deleteInvoice } from "@src/paysuite/invoices/operations",
  entities: [User, Tenant, Plan, Subscriber, Invoice]
}

action cloneInvoice {
  fn: import { cloneInvoice } from "@src/paysuite/invoices/operations",
  entities: [User, Tenant, Plan, Subscriber, Invoice, InvoiceDetail, InvoiceTax]

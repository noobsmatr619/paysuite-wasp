  component: import ProductFormPage from "@src/paysuite/products/ProductFormPage"
}

query getProducts {
  fn: import { getProducts } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Product, Category, Unit]
}

query getProduct {
  fn: import { getProduct } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Product, Category, Unit]
}

action createProduct {
  fn: import { createProduct } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Product]
}

action updateProduct {
  fn: import { updateProduct } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Product]
}

action deleteProduct {
  fn: import { deleteProduct } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Product]
}

query getCategories {
  fn: import { getCategories } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Category]
}

action createCategory {
  fn: import { createCategory } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Category]
}

query getUnits {
  fn: import { getUnits } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Unit]
}

action createUnit {
  fn: import { createUnit } from "@src/paysuite/products/operations",
  entities: [User, Tenant, Plan, Subscriber, Unit]
}
//#endregion


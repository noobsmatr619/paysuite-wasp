//#region Plans & settings
route PlansRoute { path: "/plans", to: PlansPage }
page PlansPage {
  authRequired: true,
  component: import PlansPage from "@src/paysuite/plans/PlansPage"
}

route SettingsRoute { path: "/settings", to: SettingsPage }
page SettingsPage {
  authRequired: true,
  component: import SettingsPage from "@src/paysuite/settings/SettingsPage"
}

query getPlans {
  fn: import { getPlans } from "@src/paysuite/plans/operations",
  entities: [Plan]
}

action ensureDefaultPlans {
  fn: import { ensureDefaultPlans } from "@src/paysuite/plans/operations",
  entities: [Plan]
}

query getMyPlan {
  fn: import { getMyPlan } from "@src/paysuite/plans/operations",

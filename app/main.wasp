app PaySuite {
  wasp: {
    version: "^0.22.0"
  },

  title: "PaySuite",

  head: [
    "<link rel='icon' href='/favicon.ico' />",
    "<meta name='description' content='PaySuite — multi-tenant invoicing, estimates, expenses, and subscription billing.' />",
    "<meta name='author' content='PaySuite' />",
    "<meta name='keywords' content='paysuite, invoicing, billing, estimates, saas, payments' />",
    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='PaySuite' />",
    "<meta property='og:site_name' content='PaySuite' />",
    "<meta property='og:description' content='Multi-tenant invoicing and payment suite for growing businesses.' />",
  ],

  auth: {
    userEntity: User,
    methods: {
      email: {
        fromField: {
          name: "PaySuite",
          email: "noreply@paysuite.app"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute,
          getEmailContentFn: import { getVerificationEmailContent } from "@src/auth/email-and-pass/emails",
        },
        passwordReset: {
          clientRoute: PasswordResetRoute,
          getEmailContentFn: import { getPasswordResetEmailContent } from "@src/auth/email-and-pass/emails",
        },
        userSignupFields: import { getEmailUserFields } from "@src/auth/userSignupFields",
      },
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/dashboard",
  },

  db: {
    seeds: [
      import { seedMockUsers } from "@src/server/scripts/dbSeeds",
      import { seedPaySuiteDefaults } from "@src/server/scripts/dbSeeds",
    ]
  },

  client: {
    rootComponent: import App from "@src/client/App",
  },

  server: {
    envValidationSchema: import { serverEnvValidationSchema } from "@src/env",
  },

  emailSender: {
    provider: Dummy,
    defaultFrom: {
      name: "PaySuite",
      email: "noreply@paysuite.app"
    },
  },
}

//#region Marketing
route LandingPageRoute { path: "/", to: LandingPage }
page LandingPage {
  component: import LandingPage from "@src/landing-page/LandingPage"
}

route PricingPageRoute { path: "/pricing", to: PricingPage }
page PricingPage {
  component: import PricingPage from "@src/payment/PricingPage"
}
//#endregion

//#region Auth
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/auth/LoginPage"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { Signup } from "@src/auth/SignupPage"
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email-and-pass/RequestPasswordResetPage",
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email-and-pass/PasswordResetPage",
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email-and-pass/EmailVerificationPage",
}
//#endregion

//#region User account
route AccountRoute { path: "/account", to: AccountPage }
page AccountPage {
  authRequired: true,
  component: import Account from "@src/user/AccountPage"
}

query getPaginatedUsers {
  fn: import { getPaginatedUsers } from "@src/user/operations",
  entities: [User]
}

action updateIsUserAdminById {
  fn: import { updateIsUserAdminById } from "@src/user/operations",
  entities: [User]
}
//#endregion

//#region PaySuite Dashboard
route DashboardRoute { path: "/dashboard", to: DashboardPage }
page DashboardPage {
  authRequired: true,
  component: import DashboardPage from "@src/paysuite/dashboard/DashboardPage"
}

query getDashboardStats {
  fn: import { getDashboardStats } from "@src/paysuite/dashboard/operations",
  entities: [User, Tenant, Plan, Subscriber, Customer, Product, Invoice, Estimate, Expense, Ticket, Transaction]
}

query getPaymentOverview {
  fn: import { getPaymentOverview } from "@src/paysuite/dashboard/operations",
  entities: [User, Tenant, Plan, Subscriber, Transaction, Customer, PaymentMethod, Invoice]
}

query getIncomeExpenseOverview {
  fn: import { getIncomeExpenseOverview } from "@src/paysuite/dashboard/operations",
  entities: [User, Tenant, Plan, Subscriber, Transaction, Expense]
}
//#endregion

//#region Customers
route CustomersRoute { path: "/customers", to: CustomersPage }
page CustomersPage {
  authRequired: true,
  component: import CustomersPage from "@src/paysuite/customers/CustomersPage"
}

route CustomerNewRoute { path: "/customers/new", to: CustomerFormPage }
page CustomerFormPage {
  authRequired: true,
  component: import CustomerFormPage from "@src/paysuite/customers/CustomerFormPage"
}

route CustomerEditRoute { path: "/customers/:id/edit", to: CustomerEditPage }
page CustomerEditPage {
  authRequired: true,
  component: import CustomerFormPage from "@src/paysuite/customers/CustomerFormPage"
}

route CustomerDetailRoute { path: "/customers/:id", to: CustomerDetailPage }
page CustomerDetailPage {
  authRequired: true,
  component: import CustomerDetailPage from "@src/paysuite/customers/CustomerDetailPage"
}

query getCustomers {
  fn: import { getCustomers } from "@src/paysuite/customers/operations",
  entities: [User, Tenant, Plan, Subscriber, Customer]
}

query getCustomer {
  fn: import { getCustomer } from "@src/paysuite/customers/operations",
  entities: [User, Tenant, Plan, Subscriber, Customer, Invoice, Estimate, Transaction]
}

action createCustomer {
  fn: import { createCustomer } from "@src/paysuite/customers/operations",
  entities: [User, Tenant, Plan, Subscriber, Customer]
}

action updateCustomer {
  fn: import { updateCustomer } from "@src/paysuite/customers/operations",
  entities: [User, Tenant, Plan, Subscriber, Customer]
}

action deleteCustomer {
  fn: import { deleteCustomer } from "@src/paysuite/customers/operations",
  entities: [User, Tenant, Plan, Subscriber, Customer]
}
//#endregion

//#region Products
route ProductsRoute { path: "/products", to: ProductsPage }
page ProductsPage {
  authRequired: true,
  component: import ProductsPage from "@src/paysuite/products/ProductsPage"
}

route ProductNewRoute { path: "/products/new", to: ProductFormPage }
page ProductFormPage {
  authRequired: true,
  component: import ProductFormPage from "@src/paysuite/products/ProductFormPage"
}

route ProductEditRoute { path: "/products/:id/edit", to: ProductEditPage }
page ProductEditPage {
